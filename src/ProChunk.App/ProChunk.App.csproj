<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProChunk.Core\ProChunk.Core.csproj" />
    <ProjectReference Include="..\ProChunk.Java\ProChunk.Java.csproj" />
    <ProjectReference Include="..\ProChunk.Bedrock\ProChunk.Bedrock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProChunkStudio</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>ProChunk Studio</Product>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
